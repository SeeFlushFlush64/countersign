{
  "name": "countersign-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/migrate.mjs migrate reset --force",
    "db:migrate": "node scripts/migrate.mjs migrate dev",
    "db:deploy": "node scripts/migrate.mjs migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sparticuz/chromium": "^149.0.0",
    "bcryptjs": "^3.0.3",
    "handlebars": "^4.7.9",
    "lucide-react": "^1.52.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "puppeteer-core": "^25.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "signature_pad": "^5.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "puppeteer": "^25.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
