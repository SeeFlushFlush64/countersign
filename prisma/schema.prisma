// Countersign demo — data model
// Adjusted from the source spec for Prisma/Next.js convention:
//   - camelCase fields (Prisma convention) instead of snake_case
//   - free-text `status` / `template_type` / `party_role` / `event_type` columns
//     promoted to enums for compile-time safety
//   - ids are cuid() strings, not auto-increment ints (matches how they'll be
//     used in public signing URLs)
//   - every PDF is a DocumentArtifact row (PREVIEW, FROZEN, EXECUTED) with
//     its SHA-256; the Prisma client omits the bytes from every query unless
//     a query selects them explicitly (src/lib/prisma.ts)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GENERAL_COUNSEL
  CONTRACTS_MANAGER
  BUSINESS_AFFAIRS
  PARALEGAL
}

enum TemplateType {
  NDA
  VENDOR_AGREEMENT
  MEDIA_RELEASE
  LICENSING_ORDER
}

// Agreement lifecycle. The stored values predate the product's state names
// and are kept for compatibility (migrations are additive only):
//   DRAFT            — editable, nothing sent
//   SENT             — awaiting the counterparty (frozen PDF + hash exist)
//   PARTIALLY_SIGNED — awaiting the company countersignature
//   FULLY_EXECUTED   — executed (terminal)
//   VOIDED           — voided by the company before execution (terminal)
// The database enforces that the status agrees with the signing timestamps
// and void metadata, that the countersignature never precedes the
// counterparty's signature, and that terminal statuses never change (CHECK
// constraints and a trigger in the signing_core and signing_links
// migrations).
enum DocumentStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  FULLY_EXECUTED
  VOIDED
}

enum ArtifactKind {
  FROZEN // the agreement as sent; its SHA-256 is what both parties sign
  EXECUTED // FROZEN pages + execution page with both signatures
  PREVIEW // the unsent draft, for company users only; never signed
}

enum ArtifactStatus {
  PENDING
  READY
  FAILED
}

enum PartyRole {
  COMPANY
  COUNTERPARTY
}

enum StatusEventType {
  CREATED
  SENT
  VIEWED
  SIGNED
  FULLY_EXECUTED
  LINK_REISSUED
  VOIDED
}

// Who performed an audited action. Events written before this existed have
// no actor type (a NOT VALID CHECK requires it on every new row).
enum ActorType {
  USER // an authenticated company user (actorUserId)
  COUNTERPARTY_LINK // the holder of a signing link (signingLinkId)
  SYSTEM // Countersign itself, or the seed script
}

enum LinkRevocationReason {
  SUPERSEDED // replaced by a newer link (reissue)
  VOIDED // the agreement was voided
}

// ---------------------------------------------------------------------------
// Demo epochs. The public demo starts fresh by seeding a new epoch, never by
// deleting: pages show only the current epoch's agreements, and earlier
// epochs keep their rows and append-only audit history (src/lib/demo).
// Triggers in the demo_epochs migration enforce the epoch boundary (nothing
// in a retired epoch changes), each epoch's limits, and, in demo epochs,
// reserved example domains for counterparty emails.

enum DemoEpochStatus {
  PREPARING // being seeded by a reset; not shown yet
  CURRENT // the one epoch pages show
  RETIRED // replaced by a newer epoch; kept, read-only
  ABANDONED // a reset that did not complete; kept, never shown
}

model DemoEpoch {
  id                    Int             @id @default(autoincrement())
  status                DemoEpochStatus
  // true exactly when CURRENT / PREPARING (unique: at most one of each).
  currentMarker         Boolean?        @unique
  preparingMarker       Boolean?        @unique
  isDemo                Boolean         @default(false)
  // Limits (null = unlimited) and how much of them is used.
  agreementLimit        Int?
  agreementCount        Int             @default(0)
  linkLimit             Int?
  linkCount             Int             @default(0)
  requireExampleDomains Boolean         @default(false)
  createdAt             DateTime        @default(now())
  // A preparing epoch's claim; an expired one may be abandoned by the next reset.
  leaseExpiresAt        DateTime?
  activatedAt           DateTime?
  // The last change to one of its agreements while CURRENT (null = untouched).
  lastActivityAt        DateTime?
  endedAt               DateTime?

  documents Document[]
}

model Sender {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  documents Document[]
  user      User?
}

// Login identity, separate from Sender: a User authenticates and maps 1:1
// onto the Sender they act as (mirrors how a real e-signature product ties
// an account to a team member's identity).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  senderId     String  @unique
  // Only signatories can be designated to countersign agreements.
  isSignatory  Boolean @default(false)

  sender               Sender        @relation(fields: [senderId], references: [id])
  countersignDocuments Document[]    @relation("DocumentCountersigner")
  voidedDocuments      Document[]    @relation("DocumentVoidedBy")
  issuedSigningLinks   SigningLink[] @relation("SigningLinkIssuedBy")
  auditEvents          StatusEvent[] @relation("StatusEventActorUser")
}

model Document {
  id                String         @id @default(cuid())
  title             String
  templateType      TemplateType
  senderId          String
  counterpartyName  String
  counterpartyEmail String
  status            DocumentStatus @default(DRAFT)
  createdAt         DateTime       @default(now())
  sentAt            DateTime?
  completedAt       DateTime?
  // Deprecated, no longer written or read: draft previews are PREVIEW
  // artifacts now (backfilled by the delivery_storage migration). Kept
  // because migrations are additive only.
  pdfUrl            String?
  pdfData           Bytes?

  // The authenticated company user who may countersign.
  countersignerId      String?
  // Authoritative signing timestamps (mirrored onto the Signer rows). Kept on
  // this row so a single-row CHECK constraint can enforce the order.
  counterpartySignedAt DateTime?
  countersignedAt      DateTime?
  // SHA-256 (hex) of the FROZEN artifact; a signature must name this hash.
  frozenSha256         String?

  // Supporting metadata for status VOIDED (present exactly when voided):
  // when, why and by whom. The signing timestamps keep what had happened
  // before the void.
  voidedAt   DateTime?
  voidReason String?
  voidedById String?

  // The demo epoch it belongs to (the current one unless the demo reset,
  // seeding a new epoch, names another). Never changes.
  epochId Int @default(dbgenerated("countersign_current_epoch()"))

  epoch         DemoEpoch          @relation(fields: [epochId], references: [id], onDelete: Restrict)
  sender        Sender             @relation(fields: [senderId], references: [id])
  countersigner User?              @relation("DocumentCountersigner", fields: [countersignerId], references: [id], onDelete: Restrict)
  voidedBy      User?              @relation("DocumentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  signers       Signer[]
  statusEvents  StatusEvent[]
  artifacts     DocumentArtifact[]
  signingLinks  SigningLink[]      @relation("SigningLinkDocument")
  activeLink    SigningLink?       @relation("SigningLinkActive")
  messages      OutboundMessage[]

  @@index([senderId])
  @@index([status])
  @@index([countersignerId])
  @@index([epochId])
}

// A counterparty's single-agreement scoped, expiring signing link. Only the
// SHA-256 of the random token is stored; the token itself is shown once, when
// the link is issued. At most one link per agreement is active: an active
// link carries activeDocumentId (unique), and revoking it clears that column,
// which a CHECK constraint keeps consistent with revokedAt.
model SigningLink {
  id               String                @id @default(cuid())
  documentId       String
  signerId         String
  tokenHash        String                @unique
  issuedById       String
  createdAt        DateTime
  expiresAt        DateTime
  firstViewedAt    DateTime?
  usedAt           DateTime?
  revokedAt        DateTime?
  revokedReason    LinkRevocationReason?
  activeDocumentId String?               @unique
  replacedById     String?               @unique

  document       Document          @relation("SigningLinkDocument", fields: [documentId], references: [id], onDelete: Restrict)
  activeDocument Document?         @relation("SigningLinkActive", fields: [activeDocumentId], references: [id], onDelete: Restrict)
  signer         Signer            @relation(fields: [signerId], references: [id], onDelete: Restrict)
  issuedBy       User              @relation("SigningLinkIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  replacedBy     SigningLink?      @relation("SigningLinkReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces       SigningLink?      @relation("SigningLinkReplacement")
  auditEvents    StatusEvent[]
  messages       OutboundMessage[]

  @@index([documentId])
}

// PDF artifacts, immutable once READY (a trigger rejects any change to, or
// deletion of, a READY row; a CHECK keeps sha256 equal to the bytes' hash).
// PREVIEW is created PENDING with the agreement and rendered after commit;
// FROZEN is written READY in the same transaction as the send; EXECUTED is
// created PENDING in the countersign transaction and generated after commit.
// PENDING/FAILED artifacts are generated idempotently and retried on read.
model DocumentArtifact {
  id         String         @id @default(cuid())
  documentId String
  kind       ArtifactKind
  status     ArtifactStatus
  pdfData    Bytes?
  sha256     String?
  attempts   Int            @default(0)
  lastError  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, kind])
}

model Signer {
  id            String    @id @default(cuid())
  documentId    String
  partyRole     PartyRole
  name          String
  email         String
  signedAt      DateTime?
  signatureData String?

  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signingLinks SigningLink[]

  @@unique([documentId, partyRole])
  @@index([documentId])
}

// Append-only audit log: a database trigger rejects UPDATE and DELETE.
// `actor` is a display name; the trustworthy identity is actorType plus
// actorUserId (company user) or signingLinkId (counterparty link holder).
model StatusEvent {
  id            String          @id @default(cuid())
  documentId    String
  eventType     StatusEventType
  actor         String
  timestamp     DateTime        @default(now())
  actorType     ActorType?
  actorUserId   String?
  signingLinkId String?
  // Event details, e.g. a void reason, or a hashed IP and user agent for
  // counterparty actions.
  metadata      Json?

  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorUser   User?        @relation("StatusEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  signingLink SigningLink? @relation(fields: [signingLinkId], references: [id], onDelete: Restrict)

  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Delivery: a transactional outbox. Every notification is written in the
// same transaction as the lifecycle step that causes it, then delivered after
// commit through a DeliveryAdapter (src/lib/delivery). Delivery never changes
// the agreement; a failure is recorded on the message and retried.

enum MessageKind {
  SIGNING_REQUEST // to the counterparty, with their signing link
  SIGNING_LINK_REISSUED // to the counterparty, with the replacement link
  COUNTERSIGN_REQUEST // to the designated countersigner
  AGREEMENT_EXECUTED // to both sides once executed
  AGREEMENT_VOIDED // to the counterparty, if they had been sent it
}

enum DeliveryStatus {
  PENDING // written, never attempted
  SENDING // claimed by a dispatcher until leaseExpiresAt
  DELIVERED // handed to the channel (terminal)
  FAILED // last attempt failed (lastError); retryable
  CANCELLED // never to be sent: its link was superseded or the agreement voided (terminal)
}

// Where a message was delivered. Only the demo outbox exists: in demo mode
// no email leaves Countersign.
enum DeliveryChannel {
  DEMO_OUTBOX
}

model OutboundMessage {
  id             String           @id @default(cuid())
  documentId     String
  kind           MessageKind
  recipientName  String
  recipientEmail String
  subject        String
  body           String
  // The counterparty's signing link, encrypted (AES-256-GCM, bound to
  // signingLinkId) because only a hash of the token exists anywhere else. A
  // CHECK constraint rejects anything that is not ciphertext.
  signingLinkId  String?
  linkCiphertext String?
  // A link into the company app (not a credential), e.g. the countersign page.
  appPath        String?
  status         DeliveryStatus   @default(PENDING)
  channel        DeliveryChannel?
  attempts       Int              @default(0)
  lastError      String?
  createdAt      DateTime
  lastAttemptAt  DateTime?
  leaseExpiresAt DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  document    Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  signingLink SigningLink? @relation(fields: [signingLinkId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([status, createdAt])
  @@index([signingLinkId])
}
