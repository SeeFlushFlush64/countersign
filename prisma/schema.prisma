// Countersign demo — data model
// Adjusted from the source spec for Prisma/Next.js convention:
//   - camelCase fields (Prisma convention) instead of snake_case
//   - free-text `status` / `template_type` / `party_role` / `event_type` columns
//     promoted to enums for compile-time safety
//   - ids are cuid() strings, not auto-increment ints (matches how they'll be
//     used in public signing URLs)
//   - Document gains `pdfData` (raw PDF bytes) alongside `pdfUrl`, since the
//     demo has no external object storage — pdfUrl just points at the API
//     route that streams pdfData back out

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GENERAL_COUNSEL
  CONTRACTS_MANAGER
  BUSINESS_AFFAIRS
  PARALEGAL
}

enum TemplateType {
  NDA
  VENDOR_AGREEMENT
  MEDIA_RELEASE
  LICENSING_ORDER
}

// Agreement lifecycle. The stored values predate the product's state names
// and are kept for compatibility (migrations are additive only):
//   DRAFT            — editable, nothing sent
//   SENT             — awaiting the counterparty (frozen PDF + hash exist)
//   PARTIALLY_SIGNED — awaiting the company countersignature
//   FULLY_EXECUTED   — executed (terminal)
// The database enforces that the status agrees with the signing timestamps
// and that the countersignature never precedes the counterparty's signature
// (CHECK constraints in the 20261006120000_signing_core migration).
enum DocumentStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  FULLY_EXECUTED
}

enum ArtifactKind {
  FROZEN   // the agreement as sent; its SHA-256 is what both parties sign
  EXECUTED // FROZEN pages + execution page with both signatures
}

enum ArtifactStatus {
  PENDING
  READY
  FAILED
}

enum PartyRole {
  COMPANY
  COUNTERPARTY
}

enum StatusEventType {
  CREATED
  SENT
  VIEWED
  SIGNED
  FULLY_EXECUTED
}

model Sender {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  documents Document[]
  user      User?
}

// Login identity, separate from Sender: a User authenticates and maps 1:1
// onto the Sender they act as (mirrors how a real e-signature product ties
// an account to a team member's identity).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  senderId     String  @unique
  // Only signatories can be designated to countersign agreements.
  isSignatory  Boolean @default(false)

  sender                Sender     @relation(fields: [senderId], references: [id])
  countersignDocuments  Document[] @relation("DocumentCountersigner")
}

model Document {
  id                String   @id @default(cuid())
  title             String
  templateType      TemplateType
  senderId          String
  counterpartyName  String
  counterpartyEmail String
  status            DocumentStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  sentAt            DateTime?
  completedAt       DateTime?
  // Draft preview PDF (re-rendered while the agreement is a draft).
  pdfUrl            String?
  pdfData           Bytes?

  // The authenticated company user who may countersign.
  countersignerId      String?
  // Authoritative signing timestamps (mirrored onto the Signer rows). Kept on
  // this row so a single-row CHECK constraint can enforce the order.
  counterpartySignedAt DateTime?
  countersignedAt      DateTime?
  // SHA-256 (hex) of the FROZEN artifact; a signature must name this hash.
  frozenSha256         String?

  sender        Sender             @relation(fields: [senderId], references: [id])
  countersigner User?              @relation("DocumentCountersigner", fields: [countersignerId], references: [id], onDelete: Restrict)
  signers       Signer[]
  statusEvents  StatusEvent[]
  artifacts     DocumentArtifact[]

  @@index([senderId])
  @@index([status])
  @@index([countersignerId])
}

// Immutable-once-READY PDF artifacts. FROZEN is written in the same
// transaction as the send; EXECUTED is created PENDING in the countersign
// transaction and generated after commit (idempotent, retryable).
model DocumentArtifact {
  id         String         @id @default(cuid())
  documentId String
  kind       ArtifactKind
  status     ArtifactStatus
  pdfData    Bytes?
  sha256     String?
  attempts   Int            @default(0)
  lastError  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, kind])
}

model Signer {
  id             String    @id @default(cuid())
  documentId     String
  partyRole      PartyRole
  name           String
  email          String
  signedAt       DateTime?
  signatureData  String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, partyRole])
  @@index([documentId])
}

model StatusEvent {
  id         String          @id @default(cuid())
  documentId String
  eventType  StatusEventType
  actor      String
  timestamp  DateTime        @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
