# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Database (Postgres) ---------------------------------------------------
# Pooled connection, used by the running app (Neon: the "-pooler" host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.example/DB?sslmode=verify-full
# Direct connection, used only by `npm run db:*` (Prisma migrations). Optional
# for a plain local Postgres: the CLI then falls back to DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.example/DB?sslmode=require

# --- Auth -------------------------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=

# --- Required in production (the app fails closed without them) -------------
# At least 32 random characters each.
OUTBOX_ENCRYPTION_KEY=
AUDIT_IP_HMAC_KEY=
# The only delivery mode: the in-app outbox. No email is sent.
DELIVERY_MODE=demo-outbox

# --- Hosted sample workspace only ---------------------------------------------
# DEMO_MODE=1 turns on epochs, the idle reset, and per-epoch limits.
DEMO_MODE=
